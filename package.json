{
  "name": "brass-birmingham",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "editor": "vite --open /editor.html",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "host": "tsx host/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p host/tsconfig.json"
  },
  "dependencies": {
    "pure-rand": "^7.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sonner": "^1.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "ws": "^8.20.0"
  }
}
