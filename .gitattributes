# Auto-detect text files; normalise to LF in the repo.
* text=auto eol=lf

# Explicit text
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.csv       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.svg       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
